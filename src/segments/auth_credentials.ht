import 'module:std' as std
import { logger } from '../util/logger.ht'
import { handleValidationError, warnMissingData, logParseError } from '../util/error_handler.ht'
import { getLatestNuance, generateTimedOnTimePassword } from './auth_totp.ht'
import { getToken } from './auth_token.ht'

var DateTime = std.DateTime

/**
 * Credentials 생성 유틸리티
 * 
 * WebView 쿠키로부터 sp_dc를 추출하고 TOTP를 이용하여
 * Spotify 액세스 토큰을 발급받는 기능을 제공합니다.
 */

/**
 * 쿠키를 사용하여 credentials 생성
 * 
 * Spotify 인증 프로세스:
 * 1. sp_dc 데이터 추출 및 검증
 * 2. 최신 nuance 데이터 가져오기
 * 3. TOTP 생성
 * 4. 액세스 토큰 발급
 * 
 * @param cookies List<Map> - WebView에서 가져온 인증 데이터 목록
 * @return Future<Map> - credentials 맵 (cookies, accessToken, expiration)
 * @throws Exception - sp_dc 데이터가 없거나, 네트워크 오류 발생 시
 * 
 * 사용 예시:
 * ```
 * credentialsFromData(cookies).then((creds) {
 *   print("Access token: ${creds['accessToken']}")
 *   print("Expires at: ${creds['expiration']}")
 * })
 * ```
 */
fun credentialsFromData(cookies: List) {
  logger.info("credentialsFromData", "Processing ${cookies.length} cookies")
  
  // sp_dc 쿠키 찾기
  var spDc = null
  
  logger.info("credentialsFromData", "Starting cookie iteration...")
  
  // Spotube는 Cookie 객체를 반환 - toString()에서 name이 보임
  // cookies는 이미 우리가 원하는 형태의 Map 리스트일 수 있음
  for (var i = 0; i < cookies.length; i = i + 1) {
    final cookie = cookies[i]
    final cookieStr = "${cookie}"
    logger.info("credentialsFromData", "Cookie ${i}: ${cookieStr}")
    
    // toString()에서 "name: sp_dc"를 찾기
    if (cookieStr.contains("name: sp_dc")) {
      logger.info("credentialsFromData", "✅ Found sp_dc in cookie string!")
      
      // "value: XXX"에서 XXX 추출 - 문자열 파싱
      final valueIndex = cookieStr.indexOf("value: ")
      if (valueIndex >= 0) {
        logger.info("credentialsFromData", "Found 'value: ' at index ${valueIndex}")
        final valueStart = valueIndex + 7  // "value: " 길이
        final afterValue = cookieStr.substring(valueStart)
        logger.info("credentialsFromData", "After 'value: ': ${afterValue.substring(0, 20)}...")
        
        // '}'를 찾아서 그 전까지가 값
        final endIndex = afterValue.indexOf("}")
        if (endIndex > 0) {
          spDc = afterValue.substring(0, endIndex)
          logger.info("credentialsFromData", "Extracted sp_dc value (length: ${spDc.length})")
        } else {
          logParseError("credentialsFromData", "Could not find end of value")
        }
        break
      } else {
        logParseError("credentialsFromData", "Could not find 'value: ' in cookie string")
      }
    }
  }
  
  logger.info("credentialsFromData", "sp_dc found: ${spDc != null}")

  // sp_dc 데이터 검증
  if (spDc == null || spDc.isEmpty) {
    handleValidationError("credentialsFromData", "Invalid sp_dc: Authentication data is required but was null or empty. Please log in again.")
  }

  logger.info("credentialsFromData", "Starting token generation...")
  return getLatestNuance().then((nuance){
    return generateTimedOnTimePassword(nuance["s"]).then((totp){
      return getToken(
        totp: totp,
        timestamp: DateTime.now(),
        spDc: "sp_dc=${spDc};",
        mode: "transport",
        totpVer: nuance["v"],
      ).then((res){
        if (res.body["accessToken"] == null) {
          warnMissingData("credentialsFromData", "accessToken")
        }

        return {
          cookies: cookies,
          accessToken: res.body["accessToken"],
          expiration: res.body["accessTokenExpirationTimestampMs"],
        }
      })
    })
  })
}
